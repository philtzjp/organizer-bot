{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["skill/cli.mjs"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/conventions/fixtures/**"]
        }
    }
}

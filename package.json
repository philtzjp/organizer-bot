{
    "name": "@philtz/organizer-bot-workspace",
    "private": true,
    "type": "module",
    "scripts": {
        "skills": "DISABLE_TELEMETRY=1 pnpm dlx skills add philtzjp/skills -a claude-code -a codex -a cursor -s github -s japanese -s turborepo -s conventions -y",
        "postinstall": "[ -n \"$CI\" ] || [ ! -e .git ] || pnpm run skills || true",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.0.9",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "turbo": "^2.11.4",
        "typescript": "^6.0.3"
    }
}
